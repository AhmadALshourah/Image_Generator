# ============================================================
# AI Image Generator — root .env (used by docker compose)
#
# Copy this file to .env at the repo root, then run:
#   docker compose up --build
#
# For native development (no Docker), use backend/.env.example
# instead — copy it to backend/.env and start the two servers
# manually (see README Option B).
# ============================================================

# ---- Required -------------------------------------------------------
OPENAI_API_KEY=sk-replace-me

# ---- Optional -------------------------------------------------------
# Host port for the frontend container (default 8080).
# WEB_PORT=8080

# Log format inside the API container: json (default) | console
# LOG_FORMAT=json

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
# LOG_LEVEL=INFO

# ---- Storage (default: local disk inside the api_data volume) -------
# Set to s3 to store images in an S3-compatible bucket instead.
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=        # Cloudflare R2 / MinIO endpoint; leave empty for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=     # e.g. https://cdn.example.com/ (optional CDN prefix)

# ---- Auth (disabled by default) -------------------------------------
# When true, POST /api/generate and DELETE /api/images/{id} require
# a Bearer JWT obtained via POST /api/auth/login.
# AUTH_ENABLED=false
# OWNER_USERNAME=owner
# OWNER_PASSWORD=         # plain text or bcrypt hash ($2b$...)
# JWT_SECRET=change-me-in-prod-please

# ---- Observability (Sentry — optional) ------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
