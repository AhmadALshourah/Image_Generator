# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# ---- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# ---- HTTP / CORS ----------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Persistence ----------------------------------------------------------
# Empty for local dev (uses backend/ root). Docker sets it to /data.
DATA_DIR=

# ---- Logging --------------------------------------------------------------
# LOG_LEVEL:  DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: console (colorized, dev) | json (prod / Docker)
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- Storage backend (#15) -----------------------------------------------
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
# Only used when STORAGE_BACKEND=s3:
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=            # set for Cloudflare R2 / MinIO; leave empty for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=         # e.g. https://cdn.example.com/   (optional)

# ---- Auth — owner mode (#14) ---------------------------------------------
# When false, all write endpoints are open (fine for local dev / demos).
# When true, POST /api/generate and DELETE /api/images/{id} require a
# valid Bearer JWT obtained from POST /api/auth/login.
AUTH_ENABLED=false
OWNER_USERNAME=owner
OWNER_PASSWORD=               # plain or bcrypt hash ($2b$…)
JWT_SECRET=change-me-in-prod-please
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# ---- Embeddings (#17) -----------------------------------------------------
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small

# ---- Observability — Sentry (#27) ----------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
